# ==========================================================
# FILE CẤU HÌNH MẪU CHO FRONTEND (NEXT.JS)
# Sao chép nội dung này thành frontend/.env.local khi tải về
# ==========================================================

# Địa chỉ API của Laravel Backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Địa chỉ thư mục lưu trữ ảnh công khai của Laravel (sau khi chạy php artisan storage:link)
NEXT_PUBLIC_IMAGE_URL=http://127.0.0.1:8000/storage/
