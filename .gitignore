# === Chung ===
*.log
.env
.env.backup
.env.production
!.env.example
!.env*.example
/node_modules

# === Backend (Laravel) ===
.phpactor.json
.phpunit.result.cache
/[Bb]ackend/.fleet
/[Bb]ackend/.idea
/[Bb]ackend/.nova
/[Bb]ackend/.phpunit.cache
/[Bb]ackend/.vscode
/[Bb]ackend/.zed
/[Bb]ackend/auth.json
/[Bb]ackend/node_modules
/[Bb]ackend/public/build
/[Bb]ackend/public/hot
/[Bb]ackend/public/storage
/[Bb]ackend/storage/*.key
/[Bb]ackend/storage/pail
/[Bb]ackend/vendor
Homestead.json
Homestead.yaml

# Laravel sinh ra lúc chạy. Bình thường được che bởi các .gitignore lồng trong
# backend/, nhưng những file đó chỉ tồn tại trên branch đã có commit backend.
# Khai báo lại ở đây để không lộ ra khi checkout sang branch khác.
/[Bb]ackend/bootstrap/cache/*
!/[Bb]ackend/bootstrap/cache/.gitignore
/[Bb]ackend/database/*.sqlite*
/[Bb]ackend/storage/app/private/*
!/[Bb]ackend/storage/app/private/.gitignore
/[Bb]ackend/storage/app/public/*
!/[Bb]ackend/storage/app/public/.gitignore
/[Bb]ackend/storage/framework/cache/*
!/[Bb]ackend/storage/framework/cache/.gitignore
/[Bb]ackend/storage/framework/sessions/*
!/[Bb]ackend/storage/framework/sessions/.gitignore
/[Bb]ackend/storage/framework/testing/*
!/[Bb]ackend/storage/framework/testing/.gitignore
/[Bb]ackend/storage/framework/views/*
!/[Bb]ackend/storage/framework/views/.gitignore
/[Bb]ackend/storage/logs/*
!/[Bb]ackend/storage/logs/.gitignore
/[Bb]ackend/storage/framework/compiled.php
/[Bb]ackend/storage/framework/config.php
/[Bb]ackend/storage/framework/down
/[Bb]ackend/storage/framework/maintenance.php
/[Bb]ackend/storage/framework/routes.php
/[Bb]ackend/storage/framework/services.json

# === Frontend ===
/frontend/node_modules
/frontend/dist
/frontend/build
/frontend/.next
/frontend/.nuxt
/frontend/.vite
/frontend/coverage
/frontend/.env
/frontend/.env.local
/frontend/.env.*.local
!/frontend/.env.example
!/frontend/.env*.example
/frontend/npm-debug.log*
/frontend/yarn-error.log*
/frontend/pnpm-debug.log*

# === IDE / Editor ===
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# === Hệ điều hành ===
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cache
